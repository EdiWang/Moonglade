@model IEnumerable<KeyValuePair<string, string>>
@{
    var settings = ViewData.CaptureSettings(SettingsReader).FeedSettings;
}

@if (settings.EnableSubscription)
{
    @foreach (var (key, value) in Model.OrderBy(c => c.Key))
    {
        <div class="col-6 mb-2">
            <span>
                <i class="bi-folder2 me-1"></i>
                @key
            </span>
            <span>(</span>
            @if (settings.IsFeedEnabled(FeedType.Rss))
            {
                <a asp-controller="Subscription" asp-action="Rss" asp-route-slug="@value" title="@key">
                    RSS
                </a>
            }
            @if (settings.FeedType == FeedType.Both)
            {
                <span> | </span>
            }
            @if (settings.IsFeedEnabled(FeedType.Atom))
            {
                <a asp-controller="Subscription" asp-action="Atom" asp-route-slug="@value" title="@key">
                    Atom
                </a>
            }
            <span>)</span>
        </div>
    }
}
