@page "/admin/settings/advanced"
@{
    var snapshot = ViewData.CaptureSettings(SettingsReader);
}
@Html.AntiForgeryToken()
@{
    var settings = snapshot.AdvancedSettings;
}
@section scripts {
    <script type="module" src="~/js/app/admin.settings.content.mjs"></script>
}

@section adminnavigation {
    <partial name="_SettingsNavigation" />
}

@section admintoolbar {
    <partial name="_SettingsHeader" />
}

<form id="form-settings" class="admin-settings-page" asp-controller="Settings" asp-action="Advanced">
    <div class="admin-settings-entry-container">
        <div>
            <div class="admin-settings-section">
                <div class="mb-4">
                    <h4 class="admin-subtitle fw-bold">@SharedLocalizer["Advanced Settings"]</h4>

                    <div class="settings-entry row align-items-center">
                        <div class="col-auto">
                            <i class="bi-bell settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label asp-for="@settings.EnableWebmention" class="form-check-label"></label>
                        </div>
                        <div class="col-4 text-end">
                            <div class="form-check form-switch form-control-lg">
                                <input type="hidden" name="EnableWebmention" value="false">
                                <input type="checkbox" id="@Html.IdFor(m => settings.EnableWebmention)" name="EnableWebmention" value="true" class="form-check-input" @(settings.EnableWebmention ? "checked" : null)>
                            </div>
                        </div>
                    </div>

                    <div class="settings-entry row align-items-center">
                        <div class="col-auto">
                            <i class="bi-search settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label asp-for="@settings.EnableOpenSearch" class="form-check-label"></label>
                        </div>
                        <div class="col-4 text-end">
                            <div class="form-check form-switch form-control-lg">
                                <input type="hidden" name="EnableOpenSearch" value="false">
                                <input type="checkbox" id="@Html.IdFor(m => settings.EnableOpenSearch)" name="EnableOpenSearch" value="true" class="form-check-input" @(settings.EnableOpenSearch ? "checked" : null)>
                            </div>
                        </div>
                    </div>

                    <div class="settings-entry row align-items-center">
                        <div class="col-auto">
                            <i class="bi-diagram-2 settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label asp-for="@settings.EnableFoaf" class="form-check-label"></label>
                        </div>
                        <div class="col-4 text-end">
                            <div class="form-check form-switch form-control-lg">
                                <input type="hidden" name="EnableFoaf" value="false">
                                <input type="checkbox" id="@Html.IdFor(m => settings.EnableFoaf)" name="EnableFoaf" value="true" class="form-check-input" @(settings.EnableFoaf ? "checked" : null)>
                            </div>
                        </div>
                    </div>

                    <div class="settings-entry row align-items-center">
                        <div class="col-auto">
                            <i class="bi-filetype-xml settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label asp-for="@settings.EnableOpml" class="form-check-label"></label>
                        </div>
                        <div class="col-4 text-end">
                            <div class="form-check form-switch form-control-lg">
                                <input type="hidden" name="EnableOpml" value="false">
                                <input type="checkbox" id="@Html.IdFor(m => settings.EnableOpml)" name="EnableOpml" value="true" class="form-check-input" @(settings.EnableOpml ? "checked" : null)>
                            </div>
                        </div>
                    </div>

                    <div class="settings-entry row align-items-center">
                        <div class="col-auto">
                            <i class="bi-clock settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label asp-for="@settings.EnablePostScheduler" class="form-check-label"></label>
                            <div class="form-text">@SharedLocalizer["Changes wake the scheduler. Publishing already in progress is not canceled."]</div>
                        </div>
                        <div class="col-4 text-end">
                            <div class="form-check form-switch form-control-lg">
                                <input type="hidden" name="EnablePostScheduler" value="false">
                                <input type="checkbox" id="@Html.IdFor(m => settings.EnablePostScheduler)" name="EnablePostScheduler" value="true" class="form-check-input" @(settings.EnablePostScheduler ? "checked" : null)>
                            </div>
                        </div>
                    </div>

                    <div class="settings-entry row align-items-center">
                        <div class="col-auto">
                            <i class="bi-exclamation-triangle settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label asp-for="@settings.WarnPostExternalLink" class="form-check-label"></label>
                        </div>
                        <div class="col-4 text-end">
                            <div class="form-check form-switch form-control-lg">
                                <input type="hidden" name="WarnPostExternalLink" value="false">
                                <input type="checkbox" id="@Html.IdFor(m => settings.WarnPostExternalLink)" name="WarnPostExternalLink" value="true" class="form-check-input" @(settings.WarnPostExternalLink ? "checked" : null)>
                            </div>
                        </div>
                    </div>

                    <div class="settings-entry row align-items-center">
                        <div class="col-auto">
                            <i class="bi-chat-left-text settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label asp-for="@settings.WarnCommentExternalLink" class="form-check-label"></label>
                        </div>
                        <div class="col-4 text-end">
                            <div class="form-check form-switch form-control-lg">
                                <input type="hidden" name="WarnCommentExternalLink" value="false">
                                <input type="checkbox" id="@Html.IdFor(m => settings.WarnCommentExternalLink)" name="WarnCommentExternalLink" value="true" class="form-check-input" @(settings.WarnCommentExternalLink ? "checked" : null)>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="admin-settings-section">
                <div class="settings-entry">
                    <div class="col-auto">
                        <i class="bi-code-slash settings-entry-icon" aria-hidden="true"></i>
                    </div>
                    <div class="col">
                        <label asp-for="@settings.HeadScripts"></label>
                    </div>
                    <div class="col">
                        <textarea asp-for="@settings.HeadScripts" data-setting-edit='@Html.DisplayNameFor(m => settings.HeadScripts)' class="form-control textarea-code" cols="60" rows="10" spellcheck="false"></textarea>
                    </div>
                    <template data-setting-help>
                        <div class="alert alert-warning">
                            @SharedLocalizer["Using a third party script may cause your website to be blocked by some browsers or ad blockers, it can have security risks too. Please use with caution."]
                        </div>

                        <div class="form-text">
                            @Html.Raw(string.Format(SharedLocalizer["* Global script that will be injected into every page's {0} section."].Value, "<code>head</code>")) <br />

                            @Html.Raw(string.Format(SharedLocalizer["* Please use valid {0} code."].Value, "<code>&lt;script&gt;...&lt;/script&gt;</code>"))
                        </div>
                    </template>
                </div>

                <div class="settings-entry">
                    <div class="col-auto">
                        <i class="bi-code-slash settings-entry-icon" aria-hidden="true"></i>
                    </div>
                    <div class="col">
                        <label asp-for="@settings.FootScripts"></label>
                    </div>
                    <div class="col">
                        <textarea asp-for="@settings.FootScripts" data-setting-edit='@Html.DisplayNameFor(m => settings.FootScripts)' class="form-control textarea-code" cols="60" rows="10" spellcheck="false"></textarea>
                    </div>
                    <template data-setting-help>
                        <div class="alert alert-warning">
                            @SharedLocalizer["Using a third party script may cause your website to be blocked by some browsers or ad blockers, it can have security risks too. Please use with caution."]
                        </div>

                        <div class="form-text">
                            @Html.Raw(string.Format(SharedLocalizer["* Global script that will be injected into every page's footer, before the ending of {0} tag. Typically used for third party analytics services."].Value, "<code>body</code>")) <br />

                            @Html.Raw(string.Format(SharedLocalizer["* Please use valid {0} code."].Value, "<code>&lt;script&gt;...&lt;/script&gt;</code>"))
                        </template>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<partial name="_SettingEditModal" />
