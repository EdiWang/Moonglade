@page "/admin/settings/image"
@{
    var snapshot = ViewData.CaptureSettings(SettingsReader);
}
@{
    var settings = snapshot.ImageSettings;
}

@section scripts {
    <script type="module" src="~/js/app/admin.settings.content.mjs"></script>
}

@section adminnavigation {
    <partial name="_SettingsNavigation" />
}

@section admintoolbar {
    <partial name="_SettingsHeader" />
}

<form id="form-settings" class="admin-settings-page" asp-controller="Settings" asp-action="Image">
    <div class="admin-settings-entry-container">
        <div>
            <div class="admin-settings-section">
                <h4 class="admin-subtitle fw-bold">
                    CDN
                </h4>

                <div class="admin-settings-expander">
                    <div class="settings-entry admin-settings-expander-header">
                        <div class="col-auto">
                            <i class="bi-globe settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label asp-for="@settings.EnableCDNRedirect" class="form-check-label"></label>
                        </div>
                        <div class="col-5 text-end">
                            <div class="form-check form-switch form-control-lg">
                                <input type="hidden" name="EnableCDNRedirect" value="false">
                                <input type="checkbox" id="@Html.IdFor(m => settings.EnableCDNRedirect)" name="EnableCDNRedirect" value="true" data-setting-requires="CDNEndpoint" class="form-check-input" @(settings.EnableCDNRedirect ? "checked" : null)>
                            </div>
                        </div>
                        <button type="button" class="admin-settings-expander-toggle" data-bs-toggle="collapse" data-bs-target="#settings-cdn" aria-controls="settings-cdn" aria-expanded="@(settings.EnableCDNRedirect ? "true" : "false")" aria-label="CDN">
                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div id="settings-cdn" class="collapse @(settings.EnableCDNRedirect ? "show" : null)">
                        <div class="admin-settings-expander-body">
                            <div class="settings-entry row align-items-center">
                                <div class="col-auto">
                                    <i class="bi-link settings-entry-icon"></i>
                                </div>
                                <div class="col">
                                    <label asp-for="@settings.CDNEndpoint"></label>
                                    <div class="form-text">@SharedLocalizer["e.g. https://cdn.edi.wang/ediwang-images"]</div>
                                </div>
                                <div class="col-5">
                                    <input asp-for="@settings.CDNEndpoint" data-setting-edit="" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="admin-settings-section">
                <h4 class="admin-subtitle fw-bold">
                    @SharedLocalizer["Watermark"]
                </h4>

                <div class="admin-settings-expander">
                    <div class="settings-entry admin-settings-expander-header">
                        <div class="col-auto">
                            <i class="bi-file-earmark-font settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label asp-for="@settings.IsWatermarkEnabled" class="form-check-label"></label>
                            <div class="form-text">
                                @SharedLocalizer["Watermark will be placed at the right bottom corner of the image"]
                            </div>
                        </div>
                        <div class="col-5 text-end">
                            <div class="form-check form-switch form-control-lg">
                                <input type="hidden" name="IsWatermarkEnabled" value="false">
                                <input type="checkbox" id="@Html.IdFor(m => settings.IsWatermarkEnabled)" name="IsWatermarkEnabled" value="true" class="form-check-input" @(settings.IsWatermarkEnabled ? "checked" : null)>
                            </div>
                        </div>
                        <button type="button" class="admin-settings-expander-toggle" data-bs-toggle="collapse" data-bs-target="#settings-watermark" aria-controls="settings-watermark" aria-expanded="@(settings.IsWatermarkEnabled ? "true" : "false")" aria-label="@SharedLocalizer["Watermark"]">
                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div id="settings-watermark" class="collapse @(settings.IsWatermarkEnabled ? "show" : null)">
                        <div class="admin-settings-expander-body">
                            <div class="settings-entry row align-items-center">
                                <div class="col-auto">
                                    <i class="bi-images settings-entry-icon"></i>
                                </div>
                                <div class="col">
                                    <label asp-for="@settings.KeepOriginImage" class="form-check-label"></label>
                                    <div class="form-text">
                                        @SharedLocalizer["Save the origin image as a backup while adding watermark"]
                                        <br />
                                        @SharedLocalizer["Original images are stored in the private `OriginalFileSystemPath` location."]
                                    </div>
                                </div>
                                <div class="col-3 text-end">
                                    <div class="form-check form-switch form-control-lg">
                                        <input type="hidden" name="KeepOriginImage" value="false">
                                        <input type="checkbox" id="@Html.IdFor(m => settings.KeepOriginImage)" name="KeepOriginImage" value="true" class="form-check-input" @(settings.KeepOriginImage ? "checked" : null)>
                                    </div>
                                </div>
                            </div>

                            <div class="settings-entry row align-items-center">
                                <div class="col-auto">
                                    <i class="bi-input-cursor-text settings-entry-icon"></i>
                                </div>
                                <div class="col">
                                    <label asp-for="@settings.WatermarkText"></label>
                                </div>
                                <div class="col-5">
                                    <input asp-for="@settings.WatermarkText" data-setting-edit="" class="form-control" />
                                </div>
                            </div>

                            <div class="settings-entry row align-items-center">
                                <div class="col-auto">
                                    <i class="bi-input-cursor-text settings-entry-icon"></i>
                                </div>
                                <div class="col">
                                    <label asp-for="@settings.WatermarkSkipPixel"></label>
                                    <div class="form-text">
                                        @SharedLocalizer["Add watermark only when image pixcel (HxW) is greater than this value."]
                                    </div>
                                </div>
                                <div class="col-5">
                                    <input asp-for="@settings.WatermarkSkipPixel" data-setting-edit="" required min="0" max="@int.MaxValue" class="form-control" />
                                </div>
                            </div>

                            <div class="settings-entry row align-items-center">
                                <div class="col-auto">
                                    <i class="bi-palette settings-entry-icon"></i>
                                </div>
                                <div class="col">
                                    <label>@SharedLocalizer["Alpha"]</label>
                                    <div class="form-text">
                                        @SharedLocalizer["Transparency value (0-255)."]
                                    </div>
                                </div>
                                <div class="col-5">
                                    <input asp-for="@settings.WatermarkColorA" type="range" required min="0" max="255" class="form-range" />
                                </div>
                            </div>

                            <div class="settings-entry row align-items-center">
                                <div class="col-auto">
                                    <i class="bi-fonts settings-entry-icon"></i>
                                </div>
                                <div class="col">
                                    <label asp-for="@settings.WatermarkFontSize"></label>
                                </div>
                                <div class="col-5">
                                    <input asp-for="@settings.WatermarkFontSize" data-setting-edit="" min="8" max="32" class="form-control" required />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<partial name="_SettingEditModal" />
