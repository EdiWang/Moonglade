@page "/admin/settings/image"
@{
    var snapshot = ViewData.CaptureSettings(SettingsReader);
}
@{
    var settings = snapshot.ImageSettings;
}

@section scripts {
    <script type="module" src="~/js/app/admin.settings.content.mjs"></script>
}

@section admintoolbar {
    <partial name="_SettingsHeader" />
}

<form id="form-settings" asp-controller="Settings" asp-action="Image">
    <div class="admin-settings-entry-container">
        <div class="row">
            <div class="col-6">
                <h4 class="admin-subtitle fw-bold mb-2">
                    CDN
                </h4>

                <div class="rounded-3 border mb-2">
                    <div class="settings-entry row align-items-center rounded-3 py-3 px-2">
                        <div class="col-auto">
                            <i class="bi-globe settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label asp-for="@settings.EnableCDNRedirect" class="form-check-label"></label>
                        </div>
                        <div class="col-5 text-end">
                            <div class="form-check form-switch form-control-lg">
                                <input type="hidden" name="EnableCDNRedirect" value="false">
                                <input type="checkbox" name="EnableCDNRedirect" value="true" data-setting-requires="CDNEndpoint" class="form-check-input" @(settings.EnableCDNRedirect ? "checked" : null)>
                            </div>
                        </div>
                    </div>

                    <div class="border-top settings-entry row align-items-center rounded-bottom-3 py-3 px-2">
                        <div class="col-auto">
                            <i class="bi-link settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label asp-for="@settings.CDNEndpoint"></label>
                            <div class="form-text">@SharedLocalizer["e.g. https://cdn.edi.wang/ediwang-images"]</div>
                        </div>
                        <div class="col-5">
                            <input asp-for="@settings.CDNEndpoint" data-setting-edit="" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6">
                <h4 class="admin-subtitle fw-bold mb-2">
                    @SharedLocalizer["Watermark"]
                </h4>

                <div class="settings-entry row align-items-center py-3 px-2 rounded-3 border mb-1">
                    <div class="col-auto">
                        <i class="bi-file-earmark-font settings-entry-icon"></i>
                    </div>
                    <div class="col">
                        <label asp-for="@settings.IsWatermarkEnabled" class="form-check-label"></label>
                        <div class="form-text">
                            @SharedLocalizer["Watermark will be placed at the right bottom corner of the image"]
                        </div>
                    </div>
                    <div class="col-5 text-end">
                        <div class="form-check form-switch form-control-lg">
                            <input type="hidden" name="IsWatermarkEnabled" value="false">
                            <input type="checkbox" name="IsWatermarkEnabled" value="true" class="form-check-input" @(settings.IsWatermarkEnabled ? "checked" : null)>
                        </div>
                    </div>
                </div>

                <div class="settings-entry row align-items-center py-3 px-2 rounded-3 border mb-1">
                    <div class="col-auto">
                        <i class="bi-images settings-entry-icon"></i>
                    </div>
                    <div class="col">
                        <label asp-for="@settings.KeepOriginImage" class="form-check-label"></label>
                        <div class="form-text">
                            @SharedLocalizer["Save the origin image as a backup while adding watermark"]
                            <br />
                            @SharedLocalizer["Original images are stored in the private `OriginalFileSystemPath` location."]
                        </div>
                    </div>
                    <div class="col-3 text-end">
                        <div class="form-check form-switch form-control-lg">
                            <input type="hidden" name="KeepOriginImage" value="false">
                            <input type="checkbox" name="KeepOriginImage" value="true" class="form-check-input" @(settings.KeepOriginImage ? "checked" : null)>
                        </div>
                    </div>
                </div>

                <div class="settings-entry row align-items-center py-3 px-2 rounded-3 border mb-1">
                    <div class="col-auto">
                        <i class="bi-input-cursor-text settings-entry-icon"></i>
                    </div>
                    <div class="col">
                        <label asp-for="@settings.WatermarkText"></label>
                    </div>
                    <div class="col-5">
                        <input asp-for="@settings.WatermarkText" data-setting-edit="" class="form-control" />
                    </div>
                </div>

                <div class="settings-entry row align-items-center py-3 px-2 rounded-3 border mb-1">
                    <div class="col-auto">
                        <i class="bi-input-cursor-text settings-entry-icon"></i>
                    </div>
                    <div class="col">
                        <label asp-for="@settings.WatermarkSkipPixel"></label>
                        <div class="form-text">
                            @SharedLocalizer["Add watermark only when image pixcel (HxW) is greater than this value."]
                        </div>
                    </div>
                    <div class="col-5">
                        <input asp-for="@settings.WatermarkSkipPixel" data-setting-edit="" required min="0" max="@int.MaxValue" class="form-control" />
                    </div>
                </div>

                <div class="settings-entry row align-items-center py-3 px-2 rounded-3 border mb-1">
                    <div class="col-auto">
                        <i class="bi-palette settings-entry-icon"></i>
                    </div>
                    <div class="col">
                        <label>@SharedLocalizer["Alpha"]</label>
                        <div class="form-text">
                            @SharedLocalizer["Transparency value (0-255)."]
                        </div>
                    </div>
                    <div class="col-5">
                        <div class="row g-1">
                            <div class="col">
                                <input asp-for="@settings.WatermarkColorA" type="range" required min="0" max="255" class="form-range" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="settings-entry row align-items-center py-3 px-2 rounded-3 border mb-1">
                    <div class="col-auto">
                        <i class="bi-fonts settings-entry-icon"></i>
                    </div>
                    <div class="col">
                        <label asp-for="@settings.WatermarkFontSize"></label>
                    </div>
                    <div class="col-5">
                        <input asp-for="@settings.WatermarkFontSize" data-setting-edit="" min="8" max="32" class="form-control" required />
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<partial name="_SettingEditModal" />
