@page "/admin/settings/notification"
@inject IConfiguration Configuration
@section scripts {
    <script type="module" src="~/js/app/admin.settings.notification.mjs"></script>
}

<div id="localizedStrings" style="display:none"
     data-settings-updated="@SharedLocalizer["Settings Updated"]"
     data-email-sent="@SharedLocalizer["Test email is queued."]">
</div>

@{
    var settings = BlogConfig.NotificationSettings;
    var emailProvider = string.IsNullOrWhiteSpace(Configuration["Email:Provider"])
        ? "smtp"
        : Configuration["Email:Provider"]!.Trim().ToLowerInvariant();
    var isAzureCommunicationProvider = string.Equals(
        emailProvider,
        "azurecommunication",
        StringComparison.OrdinalIgnoreCase);
    var providerLabel = isAzureCommunicationProvider ? "Azure Communication Services" : "SMTP";
    var senderAddress = isAzureCommunicationProvider
        ? Configuration["Email:AcsSenderAddress"]
        : Configuration["Email:SmtpUserName"];
    var providerConfigured = isAzureCommunicationProvider
        ? !string.IsNullOrWhiteSpace(Configuration["Email:AcsConnectionString"]) &&
          !string.IsNullOrWhiteSpace(senderAddress)
        : !string.IsNullOrWhiteSpace(Configuration["Email:SmtpServer"]) &&
          !string.IsNullOrWhiteSpace(Configuration["Email:SmtpUserName"]) &&
          !string.IsNullOrWhiteSpace(Configuration["Email:SmtpPassword"]);
    var workerEnabledValue = Configuration["Email:OutboxWorker:Enabled"];
    var workerEnabled = !bool.TryParse(workerEnabledValue, out var parsedWorkerEnabled) || parsedWorkerEnabled;
}

@section admintoolbar {
    <partial name="_SettingsHeader" />
}

<form id="form-settings" asp-controller="Settings" asp-action="Notification">
    <div class="admin-settings-entry-container">
        <div class="row">
            <div class="col-md-6">
                <div>
                    <h4 class="admin-subtitle fw-bold mb-2">@SharedLocalizer["Email Options"]</h4>

                    @if (!providerConfigured)
                    {
                        <div class="alert alert-warning">
                            @SharedLocalizer["Please configure email provider settings in appsettings.json."]
                        </div>
                    }

                    @if (!workerEnabled)
                    {
                        <div class="alert alert-warning">
                            @SharedLocalizer["Email outbox worker is disabled."]
                        </div>
                    }

                    <div class="settings-entry row align-items-center py-3 px-2 rounded-3 border mb-1">
                        <div class="col-auto">
                            <i class="bi-envelope-gear settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label>@SharedLocalizer["Provider"]</label>
                        </div>
                        <div class="col-6">
                            <input readonly="readonly" class="form-control" spellcheck="false" value="@providerLabel" />
                        </div>
                    </div>

                    <div class="settings-entry row align-items-center py-3 px-2 rounded-3 border mb-1">
                        <div class="col-auto">
                            <i class="bi-send settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label>@SharedLocalizer["Sender Address"]</label>
                        </div>
                        <div class="col-6">
                            <input readonly="readonly" class="form-control" spellcheck="false" value="@(string.IsNullOrWhiteSpace(senderAddress) ? SharedLocalizer["Not configured"] : senderAddress)" />
                        </div>
                    </div>

                    <div class="settings-entry row align-items-center py-3 px-2 rounded-3 border mb-1">
                        <div class="col-auto">
                            <i class="bi-inboxes settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label>@SharedLocalizer["Outbox Worker"]</label>
                        </div>
                        <div class="col-6">
                            <input readonly="readonly" class="form-control" spellcheck="false" value="@(workerEnabled ? SharedLocalizer["Enabled"] : SharedLocalizer["Disabled"])" />
                        </div>
                    </div>

                    <div class="settings-entry row align-items-center py-3 px-2 rounded-3 border mb-1">
                        <div class="col-auto">
                            <i class="bi-pen settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label asp-for="@settings.EmailDisplayName"></label>
                        </div>
                        <div class="col-6">
                            <input asp-for="@settings.EmailDisplayName" class="form-control" required maxlength="64" />
                        </div>
                    </div>

                    <div class="settings-entry row align-items-center py-3 px-2 rounded-3 border mb-1">
                        <div class="col-auto">
                            <i class="bi-envelope settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            @SharedLocalizer["Send Test Email"]
                        </div>
                        <div class="col-md-5 text-end">
                            <a id="a-send-test-mail" class="btn btn-sm btn-outline-accent">
                                @SharedLocalizer["Send"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div>
                    <h4 class="admin-subtitle fw-bold mb-2">@SharedLocalizer["Notification Options"]</h4>

                    <div class="settings-entry row align-items-center py-3 px-2 rounded-3 border mb-1">
                        <div class="col-auto">
                            <i class="bi-envelope settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label asp-for="@settings.EnableEmailSending" class="form-check-label"></label>
                        </div>
                        <div class="col-md-5 text-end">
                            <div class="form-check form-switch form-control-lg">
                                <input type="hidden" name="EnableEmailSending" value="false">
                                <input type="checkbox" name="EnableEmailSending" value="true" class="form-check-input" @(settings.EnableEmailSending ? "checked" : null)>
                            </div>
                        </div>
                    </div>

                    <div class="settings-entry row align-items-center py-3 px-2 rounded-3 border mb-1">
                        <div class="col-auto">
                            <i class="bi-chat-left settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label asp-for="@settings.SendEmailOnNewComment" class="form-check-label"></label>
                        </div>
                        <div class="col-md-5 text-end">
                            <div class="form-check form-switch form-control-lg">
                                <input type="hidden" name="SendEmailOnNewComment" value="false">
                                <input type="checkbox" name="SendEmailOnNewComment" value="true" class="form-check-input" @(settings.SendEmailOnNewComment ? "checked" : null)>
                            </div>
                        </div>
                    </div>

                    <div class="settings-entry row align-items-center py-3 px-2 rounded-3 border mb-1">
                        <div class="col-auto">
                            <i class="bi-reply settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label asp-for="@settings.SendEmailOnCommentReply" class="form-check-label"></label>
                        </div>
                        <div class="col-md-5 text-end">
                            <div class="form-check form-switch form-control-lg">
                                <input type="hidden" name="SendEmailOnCommentReply" value="false">
                                <input type="checkbox" name="SendEmailOnCommentReply" value="true" class="form-check-input" @(settings.SendEmailOnCommentReply ? "checked" : null)>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="admin-settings-action-container border-top pt-2 mt-2">
        <input id="btn-save-settings" type="submit" value="@SharedLocalizer["Save"]" class="btn btn-outline-accent" />
    </div>
</form>
