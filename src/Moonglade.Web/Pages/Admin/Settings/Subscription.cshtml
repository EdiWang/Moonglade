@page "/admin/settings/subscription"
@{
    var snapshot = ViewData.CaptureSettings(SettingsReader);
}
@section scripts{
    <script type="module" src="~/js/app/admin.settings.subscription.mjs"></script>
}

@{
    var settings = snapshot.FeedSettings;
}

@section adminnavigation {
    <partial name="_SettingsNavigation" />
}

@section admintoolbar{
    <partial name="_SettingsHeader" />
}

<form id="form-settings" class="admin-settings-page" asp-controller="Settings" asp-action="Subscription" spellcheck="false">
    <div class="admin-settings-entry-container">
        <div>
            <div class="admin-settings-section">
                <div class="admin-settings-expander">
                    <div class="settings-entry admin-settings-expander-header">
                        <div class="col-auto">
                            <i class="bi-rss settings-entry-icon"></i>
                        </div>
                        <div class="col">
                            <label asp-for="@settings.EnableSubscription" class="form-check-label"></label>
                        </div>
                        <div class="col-5 text-end">
                            <div class="form-check form-switch form-control-lg">
                                <input type="hidden" name="EnableSubscription" value="false">
                                <input type="checkbox" id="@Html.IdFor(m => settings.EnableSubscription)" name="EnableSubscription" value="true" class="form-check-input" @(settings.EnableSubscription ? "checked" : null)>
                            </div>
                        </div>
                        <button type="button" class="admin-settings-expander-toggle" data-bs-toggle="collapse" data-bs-target="#settings-feed-type" aria-controls="settings-feed-type" aria-expanded="@(settings.EnableSubscription ? "true" : "false")" aria-label="@SharedLocalizer["Feed type"]">
                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div id="settings-feed-type" class="collapse @(settings.EnableSubscription ? "show" : null)">
                        <fieldset id="settings-feed-options" class="admin-settings-expander-body" disabled="@(!settings.EnableSubscription)">
                            <div class="settings-entry row align-items-center">
                                <div class="col-auto">
                                    <i class="bi-list-ul settings-entry-icon"></i>
                                </div>
                                <div class="col">
                                    <label asp-for="@settings.FeedType"></label>
                                </div>
                                <div class="col-5">
                                    <select asp-for="@settings.FeedType" class="form-select">
                                        <option value="@FeedType.Rss">RSS</option>
                                        <option value="@FeedType.Atom">Atom</option>
                                        <option value="@FeedType.Both">@SharedLocalizer["Both"]</option>
                                    </select>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>

                <div class="settings-entry row align-items-center">
                    <div class="col-auto">
                        <i class="bi-list-ol settings-entry-icon"></i>
                    </div>
                    <div class="col">
                        <label asp-for="@settings.FeedItemCount"></label>
                        <div class="form-text">@SharedLocalizer["The number of entries to include in RSS/ATOM feed."]</div>
                    </div>
                    <div class="col-5">
                        <input asp-for="@settings.FeedItemCount" data-setting-edit="" class="form-control" required />
                    </div>
                </div>

                <div class="settings-entry row align-items-center">
                    <div class="col-auto">
                        <i class="bi-justify-left settings-entry-icon"></i>
                    </div>
                    <div class="col">
                        <label asp-for="@settings.UseFullContent" class="form-check-label"></label>
                    </div>
                    <div class="col-5 text-end">
                        <div class="form-check form-switch form-control-lg">
                            <input type="hidden" name="UseFullContent" value="false">
                            <input type="checkbox" id="@Html.IdFor(m => settings.UseFullContent)" name="UseFullContent" value="true" class="form-check-input" @(@settings.UseFullContent ? "checked" : null) />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<partial name="_SettingEditModal" />
