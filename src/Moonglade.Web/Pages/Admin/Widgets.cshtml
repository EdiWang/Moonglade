@page "/admin/widgets"
@{
    ViewBag.Title = "Widgets";
    ViewBag.XData = "widgetManager";
    var snapshot = ViewData.CaptureSettings(SettingsReader);
    bool sidebarEnabled = snapshot.GeneralSettings.SideBarOption != SideBarOption.Disabled;
    var regions = new (string Region, string Label, string Anchor, bool Visible)[]
    {
        ("BeforeProfile", "Before Profile", "Profile", snapshot.GeneralSettings.WidgetsProfile),
        ("BeforeTags", "Before Tags", "Tags", snapshot.GeneralSettings.HotTagAmount > 0),
        ("BeforeCategories", "Before Categories", "Categories", snapshot.GeneralSettings.WidgetsCategoryList),
        ("AfterCategories", "After Categories", "Subscription", snapshot.FeedSettings.EnableSubscription && snapshot.GeneralSettings.WidgetsSubscriptionButtons)
    };
}

@section head {
    <link rel="stylesheet" href="~/css/admin.widgets.css" asp-append-version="true" />
}
@section scripts {
    <script type="module" src="~/js/app/admin.widgets.mjs" asp-append-version="true"></script>
}

<div id="localizedStrings" hidden
     data-preview-culture="@System.Globalization.CultureInfo.CurrentUICulture.Name"
     data-draft-preview="@SharedLocalizer["Draft preview"]"
     data-updating-preview="@SharedLocalizer["Updating preview..."]"
     data-preview-invalid="@SharedLocalizer["Complete the required fields to update the preview."]"
     data-preview-failed="@SharedLocalizer["Preview unavailable. Your draft is kept."]"
     data-confirm="@SharedLocalizer["Confirm"]"
     data-loading-widgets="@SharedLocalizer["Loading widgets..."]"
     data-saving="@SharedLocalizer["Saving..."]"
     data-saved="@SharedLocalizer["Saved"]"
     data-unsaved-changes="@SharedLocalizer["Unsaved changes"]"
     data-save-not-confirmed="@SharedLocalizer["Save not confirmed"]"
     data-confirm-reload="@SharedLocalizer["Reload saved widgets? This replaces your local draft with the latest saved collection."]"
     data-confirm-discard="@SharedLocalizer["Discard all unsaved widget changes?"]"
     data-confirm-type-change="@SharedLocalizer["Change widget type? This clears its content in the draft. Saved content stays unchanged until you save."]"
     data-confirm-overwrite-after-failure="@SharedLocalizer["The previous save could not be confirmed. Replace the entire saved collection with this draft, including changes from other tabs?"]"
     data-load-failed="@SharedLocalizer["Widgets could not be loaded completely. Your draft is kept. Reload to try again."]"
     data-save-uncertain="@SharedLocalizer["The save could not be confirmed. Your draft is kept. Check the connection before retrying or reload saved widgets."]"
     data-saved-cache-failed="@SharedLocalizer["Your widgets were saved, but the public cache could not be refreshed. Your draft is kept. Reload saved widgets before continuing."]"
     data-review-errors="@SharedLocalizer["Review the highlighted fields. Nothing was saved."]"
     data-title-required="@SharedLocalizer["A widget title is required."]"
     data-title-too-long="@SharedLocalizer["Widget titles can contain up to 128 characters."]"
     data-content-too-long="@SharedLocalizer["Widget content can contain up to 2000 characters."]"
     data-widget-region-required="@SharedLocalizer["Choose a valid widget placement."]"
     data-sort-order-range="@SharedLocalizer["Sort order must be zero or greater."]"
     data-image-url-required="@SharedLocalizer["Image URL is required"]"
     data-item-name-required="@SharedLocalizer["A name or button text is required."]"
     data-item-url-required="@SharedLocalizer["A URL is required."]"
     data-button-count="@SharedLocalizer["Button widgets must contain one to three buttons."]"
     data-invalid-content="@SharedLocalizer["The widget content is invalid."]"
     data-unnamed-widget="@SharedLocalizer["Untitled widget"]"
     data-unnamed-link="@SharedLocalizer["Unnamed Link"]"
     data-unnamed-button="@SharedLocalizer["Unnamed Button"]"
     data-link-list="@SharedLocalizer["Link List"]"
     data-image-link="@SharedLocalizer["Image Link"]"
     data-button-link="@SharedLocalizer["Button Link"]"
     data-links="@SharedLocalizer["Links"]"
     data-buttons="@SharedLocalizer["Buttons"]"
     data-add-link="@SharedLocalizer["Add Link"]"
     data-add-button="@SharedLocalizer["Add Button"]"
     data-name="@SharedLocalizer["Name"]"
     data-button-text="@SharedLocalizer["Button Text"]">
</div>

@section admintoolbar {
    <div class="admin-toolbar admin-toolbar-row widget-toolbar">
        <div class="admin-toolbar-group">
            <h1 class="h5 mb-0 me-2">@SharedLocalizer["Widgets"]</h1>
            <div class="dropdown">
                <button type="button" x-ref="addWidget" disabled class="btn btn-sm btn-outline-accent dropdown-toggle" data-bs-toggle="dropdown" :disabled="locked" aria-expanded="false">
                    <i class="bi-plus-lg me-1" aria-hidden="true"></i>@SharedLocalizer["Add widget"]
                </button>
                <ul class="dropdown-menu">
                    <li><button type="button" class="dropdown-item" x-on:click="addWidget('LinkList')">@SharedLocalizer["Link List"]</button></li>
                    <li><button type="button" class="dropdown-item" x-on:click="addWidget('ImageLink')">@SharedLocalizer["Image Link"]</button></li>
                    <li><button type="button" class="dropdown-item" x-on:click="addWidget('ButtonLink')">@SharedLocalizer["Button Link"]</button></li>
                </ul>
            </div>
        </div>
        <div class="admin-toolbar-group ms-auto">
            <span class="small text-body-secondary widget-save-status" role="status" aria-live="polite" x-text="statusText"></span>
            <button type="button" class="btn btn-sm btn-outline-secondary" x-on:click="discardChanges()" :disabled="locked || !dirty">@SharedLocalizer["Discard changes"]</button>
            <button type="submit" form="widget-composer-form" disabled class="btn btn-sm btn-accent" :disabled="!canSave">
                <i class="bi-check-lg me-1" aria-hidden="true"></i>@SharedLocalizer["Save changes"]
            </button>
        </div>
    </div>
}

@Html.AntiForgeryToken()
<div class="widget-composer">
    <div x-show="loadError" x-cloak class="alert alert-danger widget-notice" role="alert">
        <span x-text="loadError"></span>
        <button type="button" class="btn btn-sm btn-outline-danger" x-on:click="loadWidgets()" :disabled="isLoading || isSaving">@SharedLocalizer["Reload saved widgets"]</button>
    </div>
    <div x-show="saveMessage" x-cloak class="alert widget-notice" :class="committed || uncertain ? 'alert-warning' : 'alert-danger'" role="alert">
        <span x-text="saveMessage"></span>
        <button type="button" class="btn btn-sm btn-outline-secondary" x-show="committed || uncertain" x-on:click="loadWidgets()" :disabled="isLoading || isSaving">@SharedLocalizer["Reload saved widgets"]</button>
    </div>
    <div class="widget-composer-grid" :aria-busy="isLoading || isSaving">
        <section class="widget-pane" aria-labelledby="widget-structure-title">
            <header class="widget-pane-heading"><h2 id="widget-structure-title">@SharedLocalizer["Sidebar structure"]</h2></header>
            <div class="widget-pane-body widget-structure">
                @if (!sidebarEnabled)
                {
                    <p class="small text-body-secondary">@SharedLocalizer["The blog sidebar is disabled."]</p>
                }
                <p x-show="isLoading" class="small text-body-secondary">@SharedLocalizer["Loading widgets..."]</p>
                <p x-show="loaded && !orderedWidgets.length" x-cloak class="small text-body-secondary">@SharedLocalizer["No widgets yet."]</p>
                @foreach (var region in regions)
                {
                    <section class="widget-region" aria-label="@SharedLocalizer[region.Label]" :class="{ 'is-drop-region': draggingId && dropRegion === '@region.Region' && !dropBeforeId }" x-on:dragover.prevent="hoverWidgetDrop('@region.Region', null, $event)" x-on:drop.prevent="dropWidget('@region.Region', null, $event)">
                        <h3>@SharedLocalizer[region.Label]</h3>
                        <template x-for="widget in regionWidgets('@region.Region')" :key="widget.id">
                            <button type="button" class="widget-structure-row" :id="`widget-select-${widget.id}`" :class="{ 'is-selected': selectedId === widget.id, 'has-errors': widgetHasErrors(widget.id), 'is-drop-before': draggingId && dropBeforeId === widget.id }" :aria-pressed="selectedId === widget.id" x-on:dragover.prevent.stop="hoverWidgetDrop(widget.region, widget.id, $event)" x-on:drop.prevent.stop="dropWidget(widget.region, widget.id, $event)" x-on:click="chooseWidget(widget.id)" :title="widget.title || t('unnamedWidget')">
                                <span class="widget-drag-handle" :draggable="!locked" x-on:dragstart.stop="startWidgetDrag(widget.id, $event)" x-on:dragend.stop="finishWidgetDrag()" title="@SharedLocalizer["Drag to move widget"]" aria-hidden="true"><i class="bi-grip-vertical"></i></span>
                                <span class="widget-row-copy">
                                    <span class="widget-row-title" x-text="widget.title || t('unnamedWidget')"></span>
                                    <span class="widget-row-type" x-text="t(widget.widgetType === 'LinkList' ? 'linkList' : widget.widgetType === 'ImageLink' ? 'imageLink' : 'buttonLink')"></span>
                                </span>
                                <span class="widget-disabled" x-show="!widget.isEnabled">@SharedLocalizer["Disabled"]</span>
                                <i class="bi-chevron-right" aria-hidden="true"></i>
                            </button>
                        </template>
                        <div class="widget-drop-zone" :class="{ 'is-visible': draggingId }" :aria-hidden="!draggingId"><span>@SharedLocalizer["Drop widget here"]</span></div>
                        <div class="widget-builtin">
                            <span>@SharedLocalizer[region.Anchor]</span>
                            <span class="small text-body-secondary">@SharedLocalizer[sidebarEnabled && region.Visible ? "Built-in" : "Hidden"]</span>
                        </div>
                    </section>
                }
                <section class="widget-removed" x-show="removedWidgets.length" x-cloak aria-labelledby="widget-removed-title">
                    <h3 id="widget-removed-title">@SharedLocalizer["Removed from draft"]</h3>
                    <template x-for="widget in removedWidgets" :key="widget.id">
                        <div class="widget-removed-row">
                            <span class="text-truncate" x-text="widget.title || t('unnamedWidget')" :title="widget.title"></span>
                            <button type="button" class="btn btn-sm btn-link" x-on:click="undoDeletion(widget.id)" :disabled="locked">@SharedLocalizer["Undo"]</button>
                        </div>
                    </template>
                </section>
            </div>
        </section>

        <section class="widget-pane widget-editor" aria-labelledby="widget-editor-title">
            <header class="widget-pane-heading">
                <h2 id="widget-editor-title">@SharedLocalizer["Edit widget"]</h2>
                <button type="button" class="btn btn-sm btn-outline-danger" x-show="selectedWidget" x-cloak x-on:click="stageDeletion()" :disabled="locked">
                    <i class="bi-trash me-1" aria-hidden="true"></i>@SharedLocalizer["Remove widget"]
                </button>
            </header>
            <div class="widget-pane-body" x-show="!selectedWidget">
                <p class="text-body-secondary mb-0" x-show="!isLoading">@SharedLocalizer["Select a widget or add one to start editing."]</p>
            </div>
            <form id="widget-composer-form" class="widget-editor-form" novalidate x-on:submit.prevent="saveChanges()" x-on:input="edited()" x-on:change="edited()">
                <template x-for="widget in selectedWidget ? [selectedWidget] : []" :key="widget.id">
                    <fieldset class="widget-pane-body widget-editor-fields" :disabled="!loaded || isLoading || isSaving">
                        <div class="mb-3">
                            <label for="widget-title" class="form-label">@SharedLocalizer["Widget title"]</label>
                            <input :disabled="committed" id="widget-title" x-ref="widgetTitle" class="form-control" x-model="widget.title" maxlength="128" required :aria-invalid="!!fieldError('title')" aria-describedby="widget-title-help widget-title-error" />
                            <div id="widget-title-help" class="form-text">@SharedLocalizer["Only link lists show this title on the blog."]</div>
                            <div id="widget-title-error" class="widget-field-error" x-text="fieldError('title')"></div>
                        </div>
                        <div class="form-check mb-3">
                            <input :disabled="committed" id="widget-enabled" class="form-check-input" type="checkbox" x-model="widget.isEnabled" />
                            <label for="widget-enabled" class="form-check-label">@SharedLocalizer["Show on blog"]</label>
                        </div>
                        <div class="mb-3">
                            <label for="widget-region" class="form-label">@SharedLocalizer["Placement"]</label>
                            <select :disabled="committed" id="widget-region" class="form-select" :value="widget.region" x-on:change="changeRegion($event.target.value)" :aria-invalid="!!fieldError('region')" aria-describedby="widget-region-error">
                                @foreach (var region in regions)
                                {
                                    <option value="@region.Region">@SharedLocalizer[region.Label]</option>
                                }
                            </select>
                            <div id="widget-region-error" class="widget-field-error" x-text="fieldError('region')"></div>
                        </div>
                        <div class="widget-move-actions mb-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary" x-on:click="moveSelected(-1)" :disabled="committed || !canMoveWidget(-1)"><i class="bi-arrow-up me-1" aria-hidden="true"></i>@SharedLocalizer["Move up"]</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" x-on:click="moveSelected(1)" :disabled="committed || !canMoveWidget(1)"><i class="bi-arrow-down me-1" aria-hidden="true"></i>@SharedLocalizer["Move down"]</button>
                        </div>
                        <div class="mb-4">
                            <label for="widget-type" class="form-label">@SharedLocalizer["Widget Type"]</label>
                            <select :disabled="committed" id="widget-type" class="form-select" :value="widget.widgetType" x-on:change.stop="changeType($event.target.value, $event.target)">
                                <option value="LinkList">@SharedLocalizer["Link List"]</option>
                                <option value="ImageLink">@SharedLocalizer["Image Link"]</option>
                                <option value="ButtonLink">@SharedLocalizer["Button Link"]</option>
                            </select>
                        </div>
                        <template x-if="widget.widgetType !== 'ImageLink'">
                            <section aria-labelledby="widget-items-title">
                                <div class="widget-content-heading">
                                    <h3 id="widget-items-title" x-text="t(widget.widgetType === 'LinkList' ? 'links' : 'buttons')"></h3>
                                    <button type="button" x-ref="addItem" class="btn btn-sm btn-outline-accent" x-on:click="addInlineItem()" :disabled="committed || widget.widgetType === 'ButtonLink' && widget.items.length >= 3">
                                        <i class="bi-plus-lg me-1" aria-hidden="true"></i><span x-text="t(widget.widgetType === 'LinkList' ? 'addLink' : 'addButton')"></span>
                                    </button>
                                </div>
                                <p x-show="!widget.items.length" class="small text-body-secondary">@SharedLocalizer["No items yet. Add one to edit its details."]</p>
                                <template x-for="(item, index) in widget.items" :key="item.key">
                                    <div class="widget-item">
                                        <div class="widget-item-heading">
                                            <button type="button" class="widget-item-toggle" :id="`item-expand-${item.key}`" :aria-expanded="item.expanded" :aria-controls="`item-editor-${item.key}`" x-on:click="item.expanded = !item.expanded">
                                                <i :class="item.expanded ? 'bi-chevron-down' : 'bi-chevron-right'" aria-hidden="true"></i><span x-text="itemLabel(item)"></span>
                                            </button>
                                            <div class="widget-item-actions">
                                                <button type="button" class="btn btn-sm btn-link text-body-secondary" x-on:click="moveInlineItem(item.key, -1)" :disabled="committed || index === 0" title="@SharedLocalizer["Move up"]" aria-label="@SharedLocalizer["Move up"]"><i class="bi-arrow-up" aria-hidden="true"></i></button>
                                                <button type="button" class="btn btn-sm btn-link text-body-secondary" x-on:click="moveInlineItem(item.key, 1)" :disabled="committed || index === widget.items.length - 1" title="@SharedLocalizer["Move down"]" aria-label="@SharedLocalizer["Move down"]"><i class="bi-arrow-down" aria-hidden="true"></i></button>
                                                <button type="button" class="btn btn-sm btn-link text-danger" x-on:click="deleteInlineItem(item.key)" :disabled="committed" title="@SharedLocalizer["Remove item"]" aria-label="@SharedLocalizer["Remove item"]"><i class="bi-trash" aria-hidden="true"></i></button>
                                            </div>
                                        </div>
                                        <div class="widget-item-editor" x-show="item.expanded" :id="`item-editor-${item.key}`">
                                            <div class="mb-3">
                                                <label class="form-label" :for="`item-name-${item.key}`" x-text="t(widget.widgetType === 'LinkList' ? 'name' : 'buttonText')"></label>
                                                <input :disabled="committed" class="form-control" :id="`item-name-${item.key}`" :value="item.data.name ?? item.data.text ?? ''" x-on:input="item.data[widget.widgetType === 'LinkList' ? 'name' : 'text'] = $event.target.value" required :aria-invalid="!!fieldError(widget.widgetType === 'LinkList' ? 'name' : 'text', item.key)" :aria-describedby="`item-name-error-${item.key}`" />
                                                <div class="widget-field-error" :id="`item-name-error-${item.key}`" x-text="fieldError(widget.widgetType === 'LinkList' ? 'name' : 'text', item.key)"></div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label" :for="`item-url-${item.key}`">@SharedLocalizer["URL"]</label>
                                                <input :disabled="committed" class="form-control" type="url" :id="`item-url-${item.key}`" x-model="item.data.url" required :aria-invalid="!!fieldError('url', item.key)" :aria-describedby="`item-url-error-${item.key}`" />
                                                <div class="widget-field-error" :id="`item-url-error-${item.key}`" x-text="fieldError('url', item.key)"></div>
                                            </div>
                                            <div class="form-check mb-3">
                                                <input :disabled="committed" class="form-check-input" type="checkbox" :id="`item-new-tab-${item.key}`" :checked="item.data.openInNewTab ?? (widget.widgetType === 'LinkList')" x-on:change="item.data.openInNewTab = $event.target.checked" />
                                                <label class="form-check-label" :for="`item-new-tab-${item.key}`">@SharedLocalizer["Open in new tab"]</label>
                                            </div>
                                            <details class="widget-advanced" :open="item.advanced" x-on:toggle="item.advanced = $event.target.open">
                                                <summary>@SharedLocalizer["Advanced options"]</summary>
                                                <template x-if="widget.widgetType === 'LinkList'">
                                                    <div class="mt-3"><label class="form-label" :for="`item-icon-${item.key}`">@SharedLocalizer["Icon"]</label><input :disabled="committed" class="form-control" :id="`item-icon-${item.key}`" x-model="item.data.icon" placeholder="bi-github" /></div>
                                                </template>
                                                <template x-if="widget.widgetType === 'ButtonLink'">
                                                    <div class="mt-3"><label class="form-label" :for="`item-css-${item.key}`">@SharedLocalizer["CSS Class"]</label><input :disabled="committed" class="form-control" :id="`item-css-${item.key}`" x-model="item.data.cssClass" /></div>
                                                </template>
                                            </details>
                                            <div class="widget-field-error" x-text="fieldError('contentCode', item.key)"></div>
                                        </div>
                                    </div>
                                </template>
                            </section>
                        </template>
                        <template x-if="widget.widgetType === 'ImageLink'">
                            <section aria-labelledby="widget-image-title">
                                <h3 id="widget-image-title">@SharedLocalizer["Image Link"]</h3>
                                <div class="mb-3"><label for="image-url" class="form-label">@SharedLocalizer["Image URL"]</label><input :disabled="committed" id="image-url" type="url" class="form-control" x-model="widget.image.imageUrl" required :aria-invalid="!!fieldError('imageUrl')" aria-describedby="image-url-error" /><div id="image-url-error" class="widget-field-error" x-text="fieldError('imageUrl')"></div></div>
                                <div class="mb-3"><label for="image-alt" class="form-label">@SharedLocalizer["Alt Text"]</label><input :disabled="committed" id="image-alt" class="form-control" x-model="widget.image.altText" /></div>
                                <div class="mb-3"><label for="image-link" class="form-label">@SharedLocalizer["Link URL"]</label><input :disabled="committed" id="image-link" type="url" class="form-control" x-model="widget.image.linkUrl" /><div class="form-text">@SharedLocalizer["Leave empty if the image should not be a hyperlink"]</div></div>
                                <div class="form-check mb-3"><input :disabled="committed" id="image-new-tab" type="checkbox" class="form-check-input" :checked="widget.image.openInNewTab ?? false" x-on:change="widget.image.openInNewTab = $event.target.checked" /><label for="image-new-tab" class="form-check-label">@SharedLocalizer["Open in new tab"]</label></div>
                                <details class="widget-advanced" :open="widget.advanced" x-on:toggle="widget.advanced = $event.target.open">
                                    <summary>@SharedLocalizer["Advanced options"]</summary>
                                    <div class="mt-3"><label for="image-title" class="form-label">@SharedLocalizer["Image Title"]</label><input :disabled="committed" id="image-title" class="form-control" x-model="widget.image.title" /></div>
                                    <div class="mt-3"><label for="image-css" class="form-label">@SharedLocalizer["CSS Class"]</label><input :disabled="committed" id="image-css" class="form-control" x-model="widget.image.cssClass" /></div>
                                </details>
                            </section>
                        </template>
                        <div class="widget-content-count text-body-secondary small"><span x-text="contentLength()"></span> / 2000 @SharedLocalizer["characters"]</div>
                        <div class="widget-field-error" x-text="fieldError('contentCode')"></div>
                    </fieldset>
                </template>
            </form>
        </section>

        <section class="widget-pane" aria-labelledby="widget-preview-title">
            <header class="widget-pane-heading">
                <h2 id="widget-preview-title">@SharedLocalizer["Blog preview"]</h2>
                <button type="button" class="btn btn-sm btn-outline-secondary" x-on:click="schedulePreview()" :disabled="!loaded || issues.length > 0" title="@SharedLocalizer["Refresh preview"]" aria-label="@SharedLocalizer["Refresh preview"]"><i class="bi-arrow-clockwise" aria-hidden="true"></i></button>
            </header>
            <div class="widget-preview-state small text-body-secondary" role="status" aria-live="polite">
                <span x-text="previewStatusText"></span>
                <span x-show="previewHtml && previewState !== 'ready'" x-cloak>@SharedLocalizer["The last preview is out of date."]</span>
                <span class="d-block">@SharedLocalizer[snapshot.GeneralSettings.SideBarOption == SideBarOption.Left ? "Left sidebar" : snapshot.GeneralSettings.SideBarOption == SideBarOption.Right ? "Right sidebar" : "The blog sidebar is disabled."]</span>
            </div>
            <div class="widget-preview-viewport">
                <iframe class="widget-preview-frame" title="@SharedLocalizer["Blog preview"]" sandbox="allow-same-origin" :srcdoc="previewHtml" :style="{ height: `${previewHeight}px` }" scrolling="no" x-on:load="measurePreview($event.target)" x-show="previewHtml" x-cloak></iframe>
            </div>
        </section>
    </div>
</div>
