@page "/admin/menu"
@{
    ViewBag.Title = "Menu";
    ViewBag.XData = "menuManager";
}

@Html.AntiForgeryToken()

@section scripts {
    <script type="module" src="~/js/app/admin.menu.mjs"></script>
}

<div id="localizedStrings" style="display:none"
     data-settings-saved="@SharedLocalizer["Settings saved successfully"]"
     data-title-required="@SharedLocalizer["Title is required"]"
     data-title-url-required="@SharedLocalizer["Title and URL are required"]"
     data-confirm-delete-menu="@SharedLocalizer["Are you sure you want to delete this menu item?"]"
     data-confirm-delete-submenu="@SharedLocalizer["Are you sure you want to delete this sub menu item?"]"
     data-confirm-clear-menus="@SharedLocalizer["Are you sure you want to clear all menu items?"]">
</div>

@section admintoolbar {
    <div class="admin-toolbar admin-toolbar-row">
        <div class="admin-toolbar-group">
            <button type="submit" form="form-settings" class="btn btn-sm btn-outline-accent" :disabled="isLoading">
                @SharedLocalizer["Save"]
            </button>
            <button type="button" class="btn btn-sm btn-outline-accent" x-on:click="openMenuItemModal()">
                <i class="bi-plus-circle" aria-hidden="true"></i> @SharedLocalizer["Add Menu Item"]
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger" x-on:click="clearMenus()">
                <i class="bi-trash" aria-hidden="true"></i> @SharedLocalizer["Clear menus"]
            </button>
        </div>
    </div>
}

<div>
    <div x-show="isLoading"
         class="text-muted mb-3"
         :class="{ 'd-flex align-items-center': isLoading }">
        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
        <span>@SharedLocalizer["Loading menu settings..."]</span>
    </div>

    <form id="form-settings" class="admin-settings-page" x-show="!isLoading" x-on:submit.prevent="saveSettings()">
        <div class="settings-entry row align-items-center">
            <div class="col-auto">
                <i class="bi-menu-app settings-entry-icon" aria-hidden="true"></i>
            </div>
            <div class="col">
                <label class="form-check-label" for="custom-menus-enabled">@SharedLocalizer["Enable custom menus"]</label>
            </div>
            <div class="col-5 text-end">
                <div class="form-check form-switch form-control-lg">
                    <input type="checkbox" id="custom-menus-enabled" x-model="settings.isEnabled" class="form-check-input" />
                </div>
            </div>
        </div>

        <div id="menu-container">
            <div id="menu-list">
                <template x-for="(item, index) in settings.menus" :key="index">
                    <div class="menu-item-card" :data-index="index">
                        <div class="menu-item-header">
                            <i :class="item.icon || 'bi-star'" class="icon-preview" aria-hidden="true"></i>
                            <div class="menu-item-copy">
                                <strong :id="`menu-title-${index}`" x-text="item.title"></strong>
                                <div class="text-body-secondary small">
                                    <span>#</span><span x-text="item.displayOrder || 1"></span>
                                    <span x-show="item.isOpenInNewTab"> &bull; @SharedLocalizer["Open in new tab"]</span>
                                    <code class="text-body-secondary" x-show="item.url" x-text="item.url"></code>
                                </div>
                            </div>
                            <div class="menu-item-actions">
                                <button type="button" class="btn btn-sm btn-link text-body-secondary text-decoration-none"
                                        x-on:click="moveMenuItem(index, 'up')"
                                        :disabled="index === 0" aria-label="@SharedLocalizer["Move up"]" :aria-describedby="`menu-title-${index}`">
                                    <i class="bi-arrow-up" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-link text-body-secondary text-decoration-none"
                                        x-on:click="moveMenuItem(index, 'down')"
                                        :disabled="index === settings.menus.length - 1" aria-label="@SharedLocalizer["Move down"]" :aria-describedby="`menu-title-${index}`">
                                    <i class="bi-arrow-down" aria-hidden="true"></i>
                                </button>
                                <div class="dropdown admin-card-actions">
                                    <button type="button" class="btn btn-sm btn-link text-body-secondary text-decoration-none"
                                            data-bs-toggle="dropdown" aria-expanded="false"
                                            aria-label="@SharedLocalizer["Actions"]" :aria-describedby="`menu-title-${index}`">
                                        <i class="bi-three-dots" aria-hidden="true"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <button type="button" class="dropdown-item" x-on:click="openMenuItemModal(index)">
                                                <i class="bi-pen me-2" aria-hidden="true"></i>@SharedLocalizer["Edit"]
                                            </button>
                                        </li>
                                        <li>
                                            <button type="button" class="dropdown-item text-danger" x-on:click="deleteMenuItem(index)">
                                                <i class="bi-trash me-2" aria-hidden="true"></i>@SharedLocalizer["Delete"]
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <button type="button" class="menu-item-expander" x-on:click="toggleMenuItem(item)"
                                    :aria-expanded="expandedMenus.has(item)" :aria-controls="`menu-children-${index}`" :aria-labelledby="`menu-title-${index}`">
                                <i class="bi-chevron-down" aria-hidden="true"></i>
                            </button>
                        </div>

                        <div :id="`menu-children-${index}`" x-show="expandedMenus.has(item)" x-cloak>
                            <template x-for="(subItem, subIndex) in (item.subMenus || [])" :key="subIndex">
                                <div class="submenu-item">
                                    <div class="menu-item-copy">
                                        <strong :id="`submenu-title-${index}-${subIndex}`" x-text="subItem.title"></strong>
                                        <div class="text-body-secondary small">
                                            <code class="text-body-secondary" x-text="subItem.url"></code>
                                            <span x-show="subItem.isOpenInNewTab"> &bull; @SharedLocalizer["Open in new tab"]</span>
                                        </div>
                                    </div>
                                    <div class="dropdown admin-card-actions">
                                        <button type="button" class="btn btn-sm btn-link text-body-secondary text-decoration-none"
                                                data-bs-toggle="dropdown" aria-expanded="false"
                                                aria-label="@SharedLocalizer["Actions"]" :aria-describedby="`submenu-title-${index}-${subIndex}`">
                                            <i class="bi-three-dots" aria-hidden="true"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <button type="button" class="dropdown-item" x-on:click="openSubMenuItemModal(index, subIndex)">
                                                    <i class="bi-pen me-2" aria-hidden="true"></i>@SharedLocalizer["Edit"]
                                                </button>
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger" x-on:click="deleteSubMenuItem(index, subIndex)">
                                                    <i class="bi-trash me-2" aria-hidden="true"></i>@SharedLocalizer["Delete"]
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </template>
                            <div class="menu-add-submenu">
                                <button type="button" class="btn btn-sm btn-outline-accent"
                                        x-on:click="openSubMenuItemModal(index)">
                                    <i class="bi-plus-circle" aria-hidden="true"></i> @SharedLocalizer["Add Sub Menu"]
                                </button>
                            </div>
                        </div>
                    </div>
                </template>
            </div>

            <div x-show="!isLoading && settings.menus.length === 0" class="empty-state">
                <i class="bi-menu-app empty-state-icon"></i>
                <h5>@SharedLocalizer["No menu items"]</h5>
                <p>@SharedLocalizer["Click 'Add Menu Item' to create your first menu."]</p>
            </div>
        </div>
    </form>
</div>

<!-- Menu Item Modal -->
<div class="modal fade" id="menuItemModal" x-ref="menuItemModal" tabindex="-1" aria-labelledby="menuItemModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="menuItemModalLabel"
                    data-edit-title="@SharedLocalizer["Edit Menu Item"]"
                    data-add-title="@SharedLocalizer["Add Menu Item"]"
                    x-text="editingIndex !== null ? $el.dataset.editTitle : $el.dataset.addTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="menu-item-form" x-on:submit.prevent="saveMenuItem()">
                    <div class="mb-3">
                        <label for="menu-title" class="form-label">@SharedLocalizer["Title"] *</label>
                        <input type="text" class="form-control" id="menu-title" x-model="currentMenuItem.title" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="menu-url" class="form-label">@SharedLocalizer["URL"]</label>
                        <input type="text" class="form-control" id="menu-url" x-model="currentMenuItem.url" placeholder="/page/about">
                        <div class="form-text">@SharedLocalizer["Leave empty for dropdown menu with sub-items only"]</div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-8">
                            <label for="menu-icon" class="form-label">@SharedLocalizer["Icon"]</label>
                            <input type="text" class="form-control" id="menu-icon" x-model="currentMenuItem.icon" placeholder="bi-star">
                            <div class="form-text">@SharedLocalizer["Bootstrap Icons class name"]</div>
                        </div>
                        <div class="col-4">
                            <label class="form-label">@SharedLocalizer["Preview"]</label>
                            <div><i id="icon-preview" :class="currentMenuItem.icon || 'bi-star'"></i></div>
                        </div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-6">
                            <label for="menu-order" class="form-label">@SharedLocalizer["Display Order"]</label>
                            <input type="number" class="form-control" id="menu-order" x-model.number="currentMenuItem.displayOrder" min="1">
                        </div>
                        <div class="col-6">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" id="menu-new-tab" x-model="currentMenuItem.isOpenInNewTab">
                                <label class="form-check-label" for="menu-new-tab">
                                    @SharedLocalizer["Open in new tab"]
                                </label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@SharedLocalizer["Cancel"]</button>
                <button type="button" class="btn btn-outline-accent" x-on:click="saveMenuItem()">@SharedLocalizer["Save"]</button>
            </div>
        </div>
    </div>
</div>

<!-- Sub Menu Item Modal -->
<div class="modal fade" id="subMenuItemModal" x-ref="subMenuItemModal" tabindex="-1" aria-labelledby="subMenuItemModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="subMenuItemModalLabel"
                    data-edit-title="@SharedLocalizer["Edit Sub Menu Item"]"
                    data-add-title="@SharedLocalizer["Add Sub Menu Item"]"
                    x-text="editingSubIndex !== null ? $el.dataset.editTitle : $el.dataset.addTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="sub-menu-item-form" x-on:submit.prevent="saveSubMenuItem()">
                    <div class="mb-3">
                        <label for="sub-menu-title" class="form-label">@SharedLocalizer["Title"] *</label>
                        <input type="text" class="form-control" id="sub-menu-title" x-model="currentSubMenuItem.title" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="sub-menu-url" class="form-label">@SharedLocalizer["URL"] *</label>
                        <input type="text" class="form-control" id="sub-menu-url" x-model="currentSubMenuItem.url" required placeholder="https://example.com">
                    </div>
                    
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="sub-menu-new-tab" x-model="currentSubMenuItem.isOpenInNewTab">
                        <label class="form-check-label" for="sub-menu-new-tab">
                            @SharedLocalizer["Open in new tab"]
                        </label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@SharedLocalizer["Cancel"]</button>
                <button type="button" class="btn btn-outline-accent" x-on:click="saveSubMenuItem()">@SharedLocalizer["Save"]</button>
            </div>
        </div>
    </div>
</div>
