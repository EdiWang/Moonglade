@page "/admin/tags"
@using Moonglade.Features.Tag
@{
    ViewBag.Title = "Tags";
    ViewBag.XData = "tagManager";
}

@section scripts {
    <script type="module" src="~/js/app/admin.tags.mjs"></script>
}

<div id="localizedStrings" style="display:none"
     data-tag-updated="@SharedLocalizer["Tag updated"]"
     data-tag-deleted="@SharedLocalizer["Tag deleted"]"
     data-tag-added="@SharedLocalizer["Tag added"]">
</div>

@section admintoolbar {
    <div class="admin-toolbar admin-toolbar-row">
        <div class="admin-toolbar-group">
            <button type="button" x-on:click="initCreateTag()" class="btn btn-sm btn-outline-accent">
                <i class="bi-plus-lg" aria-hidden="true"></i>
                @SharedLocalizer["New"]
            </button>
        </div>

        <input x-model="tagFilter"
               x-on:input="filterTags()"
               type="text"
               class="form-control admin-tags-filter ms-auto"
               maxlength="32"
               placeholder="@SharedLocalizer["Filter"]"
               aria-label="@SharedLocalizer["Filter tags"]">
    </div>
}

@Html.AntiForgeryToken()

<div class="admin-panel">
    <div x-show="isLoading"
         class="text-muted"
         :class="{ 'd-flex align-items-center': isLoading }">
        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
        <span>@SharedLocalizer["Loading tags..."]</span>
    </div>

    <div x-show="!isLoading && !hasTags" class="alert alert-info mb-0" role="alert">
        @SharedLocalizer["No tags found. Create your first tag to get started."]
    </div>

    <div x-show="!isLoading && hasTags && groupedTags.length === 0" class="alert alert-info mb-0" role="alert">
        @SharedLocalizer["no items to show"]
    </div>

    <div x-show="!isLoading && hasTags" class="tag-manager-container admin-list">
        <template x-for="group in groupedTags" :key="group.letter">
            <div class="tag-letter-group admin-list-item border-0 gap-3" :id="'tag-group-' + group.letter">
                <div class="tag-letter-tile">
                    <span x-text="group.letter"></span>
                </div>
                <ul class="list-unstyled ul-tag-mgr mb-0" role="list">
                    <template x-for="tagItem in group.tags" :key="tagItem.id">
                        <li :id="`li-tag-${tagItem.id}`" class="admin-tag-item border rounded me-1"
                            :class="{ 'border-warning': tagItem.postCount === 0 }">
                            <span x-show="tagItem.postCount === 0" class="visually-hidden">@SharedLocalizer["Tags without posts"]</span>
                            <span class="span-tagcontent-editable"
                                  contenteditable="true"
                                  spellcheck="false"
                                  :data-tagid="tagItem.id"
                                  x-on:blur="updateTag($event, tagItem.id)"
                                  :aria-label="`@SharedLocalizer["Edit tag"]` + ' ' + tagItem.displayName"
                                  x-text="tagItem.displayName">
                            </span>
                            <span class="tag-postcount"
                                  :title="`@SharedLocalizer["{0} posts", "${tagItem.postCount}"]`"
                                  x-text="tagItem.postCount">
                            </span>
                            <a class="btn-delete"
                               x-on:click="deleteTag(tagItem.id, tagItem.displayName)"
                               :aria-label="`@SharedLocalizer["Delete tag"]` + ' ' + tagItem.displayName"
                               title="@SharedLocalizer["Delete tag"]"
                               role="button">
                                <i class="bi-trash"></i>
                            </a>
                        </li>
                    </template>
                </ul>
            </div>
        </template>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" x-ref="editTagCanvas" aria-labelledby="editTagCanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="editTagCanvasLabel">@SharedLocalizer["Create Tag"]</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Close"]"></button>
    </div>
    <div class="offcanvas-body">
        <form x-on:submit.prevent="handleSubmit()">
            <div class="mb-3">
                <label for="input-tag-name" class="form-label">
                    @SharedLocalizer["Name"] <span class="text-danger">*</span>
                </label>
                <input type="text"
                       x-model="formData.displayName"
                       id="input-tag-name"
                       class="form-control"
                       required
                       maxlength="50"
                       aria-describedby="tag-name-help"
                       placeholder="@SharedLocalizer["Enter tag name"]" />
                <div id="tag-name-help" class="form-text">
                    @SharedLocalizer["Tag names should be descriptive and concise."]
                </div>
                <div class="invalid-feedback">
                    @SharedLocalizer["Please provide a valid tag name."]
                </div>
            </div>
            <div class="d-grid gap-2 admin-offcanvas-actions">
                <button type="submit" class="btn btn-outline-accent">
                    <i class="bi-check-lg"></i>
                    @SharedLocalizer["Submit"]
                </button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">
                    @SharedLocalizer["Cancel"]
                </button>
            </div>
        </form>
    </div>
</div>
