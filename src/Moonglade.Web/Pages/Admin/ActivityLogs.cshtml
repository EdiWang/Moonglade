@page "/admin/activitylogs"
@{
    ViewBag.Title = "Activity Logs";
    ViewBag.XData = "activityLogManager";
}

@Html.AntiForgeryToken()

@section scripts {
    <script type="module" src="~/js/app/admin.activitylogs.mjs"></script>
}

@section admintoolbar {
    <div class="admin-toolbar admin-toolbar-row">
        <div class="admin-toolbar-group">
            <button type="button" x-on:click="clearAllLogs()" class="btn btn-sm btn-outline-danger">
                <i class="bi-trash" aria-hidden="true"></i>
                @SharedLocalizer["Clear all"]
            </button>
        </div>
        <div class="admin-toolbar-group ms-auto">
            <button type="button" x-on:click="openFilter()" class="btn btn-sm btn-outline-accent">
                <i class="bi-funnel" aria-hidden="true"></i>
                @SharedLocalizer["Filter"]
                <span x-show="activeFilterCount > 0" class="badge bg-danger ms-1" x-text="activeFilterCount"></span>
            </button>
        </div>
    </div>
}

<div id="localizedStrings" style="display:none"
     data-clear-all="@SharedLocalizer["Clear all"]"
     data-logs-cleared="@SharedLocalizer["Activity logs are cleared"]"
     data-yes="@SharedLocalizer["Yes"]"
     data-no="@SharedLocalizer["No"]"
     data-draft="@SharedLocalizer["Draft"]"
     data-published="@SharedLocalizer["Published"]"
     data-scheduled="@SharedLocalizer["Scheduled"]"
     data-right="@SharedLocalizer["Right"]"
     data-left="@SharedLocalizer["Left"]"
     data-disabled="@SharedLocalizer["Disabled"]"
     data-center="@SharedLocalizer["Center"]"
     data-html="HTML"
     data-markdown="Markdown"
     data-built-in="@SharedLocalizer["Built in"]"
     data-third-party="@SharedLocalizer["Third party"]"
     data-old-to-new="@SharedLocalizer["Old to new"]"
     data-new-to-old="@SharedLocalizer["New to old"]"
     data-mask-word="@SharedLocalizer["Mask Word"]"
     data-block-comment="@SharedLocalizer["Block Comment"]"
     data-confirm-clear-all-logs="@SharedLocalizer["Are you sure you want to clear all activity logs? This action will be recorded."]">
</div>

<div class="admin-panel p-0 overflow-hidden">
    <div x-show="isLoading"
         class="text-muted p-4"
         :class="{ 'd-flex align-items-center': isLoading }">
        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
        <span>@SharedLocalizer["Loading..."]</span>
    </div>

    <div x-show="!isLoading && !hasLogs" class="p-4">
        <div class="alert alert-info mb-0">
            @SharedLocalizer["No activity logs found."]
        </div>
    </div>

    <div x-show="!isLoading && hasLogs" class="table-responsive">
        <table class="table table-sm table-hover admin-data-table admin-activity-table align-middle mb-0">
            <colgroup>
                <col class="activity-log-column-time" />
                <col class="activity-log-column-actor" />
                <col />
                <col class="activity-log-column-actions" />
            </colgroup>
            <thead>
                <tr>
                    <th scope="col" class="px-3 py-2 fw-semibold text-body-secondary">@SharedLocalizer["Time"]</th>
                    <th scope="col" class="px-3 py-2 fw-semibold text-body-secondary">@SharedLocalizer["Actor"]</th>
                    <th scope="col" class="px-3 py-2 fw-semibold text-body-secondary">@SharedLocalizer["Activity"]</th>
                    <th scope="col" class="px-3 py-2 fw-semibold text-body-secondary text-end">@SharedLocalizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                <template x-for="log in logs" :key="log.id">
                    <tr :id="`log-${log.id}`">
                        <td class="px-3 text-body-secondary text-break">
                            <time :data-utc-label="log.eventTimeUtc" x-text="log.eventTimeUtc"></time>
                        </td>
                        <td class="px-3 text-body-secondary text-break">
                            <i :class="log.actorKind === 'System' ? 'bi-gear' : 'bi-person'"
                               :title="log.actorKind === 'System' ? '@SharedLocalizer["System"]' : '@SharedLocalizer["Administrator"]'"></i>
                            <span x-text="log.actor"></span>
                        </td>
                        <td class="px-3 text-break">
                            <span x-text="log.summary"></span>
                        </td>
                        <td class="px-3 text-end">
                            <button class="btn btn-outline-accent btn-sm"
                                    x-on:click="showDetail(log.id, $event.currentTarget)" aria-controls="detailCanvas"
                                    aria-label="@SharedLocalizer["Detail"]" title="@SharedLocalizer["Detail"]">
                                <i class="bi-info-circle" aria-hidden="true"></i>
                            </button>
                        </td>
                    </tr>
                </template>
            </tbody>
        </table>
    </div>
</div>

<div x-show.important="hasLogs" class="admin-pagination d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
    <nav x-show="totalPages > 1" aria-label="Page navigation">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item" :class="{ 'disabled': currentPage === 1 }">
                <a class="page-link" href="#" x-on:click.prevent="goToPage(currentPage - 1)">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>

            <template x-for="page in paginationPages" :key="page">
                <li class="page-item" :class="{ 'active': page === currentPage }">
                    <a class="page-link" href="#" x-on:click.prevent="goToPage(page)" x-text="page"></a>
                </li>
            </template>

            <li class="page-item" :class="{ 'disabled': currentPage === totalPages }">
                <a class="page-link" href="#" x-on:click.prevent="goToPage(currentPage + 1)">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>

    <div class="d-flex align-items-center gap-2 ms-auto">
        <label class="form-label mb-0 text-nowrap">@SharedLocalizer["Page Size"]</label>
        <select class="form-select form-select-sm" style="width: auto;"
                x-on:change="changePageSize($event.target.value)">
            <template x-for="size in pageSizeOptions" :key="size">
                <option :value="size" x-text="size" :selected="size === pageSize"></option>
            </template>
        </select>
    </div>
</div>

<!-- Filter Offcanvas -->
<div class="offcanvas offcanvas-end" tabindex="-1" x-ref="filterCanvas" aria-labelledby="filterCanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="filterCanvasLabel">@SharedLocalizer["Filter"]</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column p-0">
        <form x-on:submit.prevent="handleFilter()" class="d-flex flex-column h-100">
            <!-- Event Types Card - Takes remaining space -->
            <div class="flex-grow-1 d-flex flex-column p-3 pb-0" style="min-height: 0;">
                <div class="card d-flex flex-column h-100">
                    <div class="card-header">
                        <h6 class="mb-0 fw-semibold">@SharedLocalizer["Event Types"]</h6>
                    </div>
                    <div class="card-body flex-grow-1 overflow-auto">
                        <template x-for="group in eventTypeGroups" :key="group.label">
                            <div class="mb-3">
                                <div class="text-muted small fw-semibold text-uppercase mb-2" x-text="group.label"></div>
                                <template x-for="item in group.items" :key="item.key">
                                    <div class="form-check mb-1">
                                        <input class="form-check-input" type="checkbox"
                                               :id="`evt-${item.key}`"
                                               :value="item.key"
                                               :checked="selectedEventKeys.includes(item.key)"
                                               x-on:change="toggleEventKey(item.key)">
                                        <label class="form-check-label" :for="`evt-${item.key}`" x-text="item.label"></label>
                                    </div>
                                </template>
                            </div>
                        </template>
                    </div>
                </div>
            </div>

            <!-- Date Range Filters - Fixed position above buttons -->
            <div class="p-3">
                <div class="mb-3">
                    <label class="form-label">@SharedLocalizer["Start Date"]</label>
                    <input type="date" class="form-control" x-model="startDate" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@SharedLocalizer["End Date"]</label>
                    <input type="date" class="form-control" x-model="endDate" />
                </div>
            </div>

            <!-- Fixed Bottom Buttons -->
            <div class="border-top p-3 bg-light">
                <div class="d-grid gap-2 admin-offcanvas-actions">
                    <button type="submit" class="btn btn-accent">
                        <i class="bi-funnel"></i> @SharedLocalizer["Apply Filter"]
                    </button>
                    <button type="button" class="btn btn-outline-secondary" x-on:click="clearFilter()">
                        <i class="bi-x-circle"></i> @SharedLocalizer["Clear"]
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="detailCanvas" x-ref="detailCanvas"
     aria-labelledby="detailCanvasLabel" style="--bs-offcanvas-width: 480px;">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title text-break" id="detailCanvasLabel" x-text="currentDetail?.heading"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Close"]"></button>
    </div>
    <div class="offcanvas-body text-break">
        <dl class="d-grid gap-3 mb-0">
            <div>
                <dt class="small text-body-secondary">@SharedLocalizer["Time"]</dt>
                <dd class="mb-0"><time :data-utc-label="currentDetail?.eventTimeUtc" x-text="currentDetail?.eventTimeUtc"></time></dd>
            </div>
            <div>
                <dt class="small text-body-secondary">@SharedLocalizer["Actor"]</dt>
                <dd class="mb-0" x-text="currentDetail?.actor"></dd>
            </div>
            <div>
                <dt class="small text-body-secondary">@SharedLocalizer["Actor type"]</dt>
                <dd class="mb-0" x-text="currentDetail?.actorKind === 'System' ? '@SharedLocalizer["System"]' : '@SharedLocalizer["Administrator"]'"></dd>
            </div>
        </dl>
        <dl class="d-grid gap-3 border-top pt-3 mt-3 mb-0" x-show.important="hasDetailContext">
            <template x-if="currentDetail?.targetDisplayName">
                <div>
                    <dt class="small text-body-secondary">@SharedLocalizer["Target"]</dt>
                    <dd class="mb-0" x-text="currentDetail.targetDisplayName"></dd>
                </div>
            </template>
            <template x-if="currentDetail?.targetId">
                <div>
                    <dt class="small text-body-secondary">@SharedLocalizer["Target ID"]</dt>
                    <dd class="mb-0" x-text="currentDetail.targetId"></dd>
                </div>
            </template>
            <template x-if="currentDetail?.ipAddress">
                <div>
                    <dt class="small text-body-secondary">@SharedLocalizer["IP Address"]</dt>
                    <dd class="mb-0 mt-1"><code class="d-block rounded bg-body-tertiary p-2 text-body" x-text="currentDetail.ipAddress"></code></dd>
                </div>
            </template>
            <template x-if="currentDetail?.userAgent">
                <div>
                    <dt class="small text-body-secondary">@SharedLocalizer["User Agent"]</dt>
                    <dd class="mb-0 mt-1"><code class="d-block rounded bg-body-tertiary p-2 text-body" x-text="currentDetail.userAgent"></code></dd>
                </div>
            </template>
        </dl>
        <dl class="d-grid gap-3 border-top pt-3 mt-3 mb-0" x-show.important="currentDetail?.fields?.length">
            <template x-for="field in currentDetail?.fields ?? []" :key="field.key">
                <div>
                    <dt class="small text-body-secondary" x-text="field.label"></dt>
                    <dd class="mb-0" x-text="formatDetailValue(field.value, field.key)"></dd>
                </div>
            </template>
        </dl>
        <section class="border-top pt-3 mt-3" x-show="hasSettingsChanges">
            <h6>@SharedLocalizer["Settings changes"]</h6>
            <dl class="d-grid gap-3 mb-0" x-show.important="currentDetail?.changes?.length">
                <template x-for="change in currentDetail?.changes ?? []" :key="change.key">
                    <div class="rounded border p-3">
                        <dt x-text="change.label"></dt>
                        <dd class="mb-0 mt-2">
                            <dl class="d-grid gap-2 mb-0">
                                <div>
                                    <dt class="small text-body-secondary">@SharedLocalizer["Previous value"]</dt>
                                    <dd class="mb-0" x-text="formatDetailValue(change.oldValue, change.key)"></dd>
                                </div>
                                <div>
                                    <dt class="small text-body-secondary">@SharedLocalizer["New value"]</dt>
                                    <dd class="mb-0" x-text="formatDetailValue(change.newValue, change.key)"></dd>
                                </div>
                            </dl>
                        </dd>
                    </div>
                </template>
            </dl>
            <p class="text-muted mb-0" x-show="!currentDetail?.changes?.length">
                @SharedLocalizer["No change values are available for this update."]
            </p>
        </section>
        <p class="text-muted mt-3 mb-0" x-show="!hasSettingsChanges && !hasDetailContext && !currentDetail?.fields?.length">
            @SharedLocalizer["No additional activity details are available."]
        </p>
    </div>
</div>
