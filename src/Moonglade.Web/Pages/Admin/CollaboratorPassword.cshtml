@page "/admin/account/password"
@attribute [Authorize(Policy = BlogAuthSchemas.CollaboratorSelfServicePolicy)]
@{
    ViewBag.Title = SharedLocalizer["Change Password"];
}

@section scripts {
    <script type="module" src="~/js/app/admin.collaborator-password.mjs" asp-append-version="true"></script>
}

<div class="admin-settings-page">
    <form id="collaborator-password-form" method="post" asp-page="/Admin/CollaboratorPassword" class="admin-panel p-4"
          data-save-url="@Url.Content("~/api/account/collaborator/password")"
          data-success="@SharedLocalizer["Password updated."]">
        <h1 class="h5 mb-3">@SharedLocalizer["Change Password"]</h1>
        <div class="mb-3">
            <label class="form-label" for="old-password">@SharedLocalizer["Current password"]</label>
            <input class="form-control" id="old-password" name="OldPassword" type="password" autocomplete="current-password" required />
        </div>
        <div class="mb-3">
            <label class="form-label" for="new-password">@SharedLocalizer["New password"]</label>
            <input class="form-control" id="new-password" name="NewPassword" type="password" autocomplete="new-password"
                   minlength="8" pattern="@UpdateLocalAccountPasswordRequest.PasswordPattern" aria-describedby="new-password-requirements" required />
            <div class="form-text" id="new-password-requirements">@SharedLocalizer[UpdateLocalAccountPasswordRequest.PasswordRequirements]</div>
        </div>
        <button type="submit" class="btn btn-outline-accent">@SharedLocalizer["Change Password"]</button>
    </form>
</div>
