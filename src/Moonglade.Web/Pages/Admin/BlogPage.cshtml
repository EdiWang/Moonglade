@page "/admin/page"
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Moonglade.Features.Page
@{
    ViewBag.Title = "Pages";
    ViewBag.XData = "pageManager";
}

@section scripts {
    <script type="module" src="~/js/app/admin.blogpage.mjs"></script>
}

<div id="localizedStrings" style="display:none"
     data-page-deleted="@SharedLocalizer["Page deleted"]">
</div>

@section adminnavigation {
    <partial name="_PageManageNavigation" />
}

@section admintoolbar {
    <partial name="_PageManageHeader" />
}

@Html.AntiForgeryToken()

<div x-show="isLoading"
     class="text-muted mb-3"
     :class="{ 'd-flex align-items-center': isLoading }">
    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
    <span>@SharedLocalizer["Loading pages..."]</span>
</div>

<div x-show="!isLoading && !hasPages" class="empty-recycle">
    <div class="text-center">
        <h4>@SharedLocalizer["No Pages"]</h4>
        <p class="text-muted">@SharedLocalizer["no items to show"]</p>
    </div>
</div>

<div x-show="!isLoading && hasPages" class="row row-cols-4 admin-card-grid">
    <template x-for="page in sortedPages" :key="page.id">
        <div class="col">
            <div class="card admin-card" :id="`card-${page.id}`">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 pe-3">
                        <h6 class="card-title" :id="`page-card-title-${page.id}`">
                            <a :href="`/page/${encodeURIComponent(page.slug)}`" target="_blank" x-text="page.title"></a>
                        </h6>
                        <span x-show="page.isPublished" x-cloak class="badge bg-success">@SharedLocalizer["Published"]</span>
                        <span x-show="!page.isPublished" x-cloak class="badge bg-secondary">@SharedLocalizer["Unpublished"]</span>
                    </div>
                    <p class="mt-2" x-text="page.slug"></p>
                    <small class="text-muted" x-text="formatDate(page.createTimeUtc)"></small>
                </div>
                <div class="dropdown admin-card-actions position-absolute top-0 end-0">
                    <button type="button" class="btn btn-sm btn-link text-body-secondary text-decoration-none"
                            data-bs-toggle="dropdown" aria-expanded="false"
                            aria-label="@SharedLocalizer["Actions"]" :aria-describedby="`page-card-title-${page.id}`">
                        <i class="bi-three-dots" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" :href="`./page/edit/${page.id}`">
                                <i class="bi-pen me-2" aria-hidden="true"></i>@SharedLocalizer["Edit"]
                            </a>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item text-danger" x-on:click="showDeleteModal(page.id)">
                                <i class="bi-trash me-2" aria-hidden="true"></i>@SharedLocalizer["Delete"]
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </template>
</div>
