@page "/auth/setup-account"
@model Moonglade.Web.Pages.SetupAccountModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@SharedLocalizer["Set up Account"]</title>
    <partial name="_Favicons" />
    <link href="~/lib/twitter-bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/base.css" rel="stylesheet" />
</head>
<body class="bg-body-tertiary">
    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-sm-8 col-md-6 col-lg-4">
                <h1 class="h4 mb-4">@SharedLocalizer["Set up Account"]</h1>
                @if (Model.IsVerifying)
                {
                    <div class="text-center mb-3">
                        <img class="img-fluid" src="@Model.QrCodeImageUri" alt="@SharedLocalizer["Authenticator QR code"]" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="setup-key">@SharedLocalizer["Manual setup key"]</label>
                        <input id="setup-key" class="form-control font-monospace" value="@Model.SetupKey" readonly />
                    </div>
                    <form method="post" asp-page-handler="Verify">
                        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                        <partial name="_AuthenticatorCode" />
                        <button class="btn btn-primary w-100" type="submit">@SharedLocalizer["Verify"]</button>
                    </form>
                }
                else
                {
                    <form method="post">
                        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" type="email" class="form-control" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="254" required />
                        </div>
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" minlength="8" required />
                        </div>
                        <button class="btn btn-primary w-100" type="submit">@SharedLocalizer["Create Account"]</button>
                    </form>
                }
            </div>
        </div>
    </main>
    <script type="module" src="~/js/app/base.mjs"></script>
    <script type="module" src="~/js/app/authenticator-code.mjs"></script>
</body>
</html>
