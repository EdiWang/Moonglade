@page "/auth/signin"
@{
    var snapshot = ViewData.CaptureSettings(SettingsReader);
}
@inject ICacheAside Cache
@inject ThemeCacheInvalidator ThemeCache
@model Moonglade.Web.Pages.SignInModel
@using Edi.AspNetCore.Utils
@using Moonglade.Utils

@{
    Layout = null;

    var themeCss = await Cache.GetOrCreateAsync(BlogCachePartition.General.ToString(), ThemeCache.GetCacheKey(snapshot.AppearanceSettings.ThemeId), async () =>
    {
        return await QueryMediator.QueryAsync(new GetSiteThemeStyleSheetQuery(snapshot.AppearanceSettings.ThemeId));
    }, TimeSpan.FromMinutes(20));
}

<!DOCTYPE html>
<html lang="@snapshot.GeneralSettings.DefaultLanguageCode">
<head>
    <title>
        @SharedLocalizer["Admin Sign In"]
    </title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <partial name="_Favicons" />
    <link href="~/lib/twitter-bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/base.css" rel="stylesheet" />
    @if (!string.IsNullOrEmpty(themeCss))
    {
        themeCss = themeCss.Replace("</style", string.Empty, StringComparison.OrdinalIgnoreCase);
        <style>@Html.Raw(themeCss)</style>
    }
    <link href="~/Moonglade.Web.styles.css" rel="stylesheet" />
</head>
<body class="bg-gray-1">
    <main class="signin-page">
        <div class="signin-content">
            <h1 class="h4 mb-4">@SharedLocalizer["Sign In"]</h1>

            <form method="post">
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" autocomplete="username" autocapitalize="none" spellcheck="false" required minlength="2" maxlength="32" />
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" required pattern="@("^(?=.*[a-zA-Z])(?=.*[0-9])[A-Za-z0-9._~!@#$^&*]{8,}$")" minlength="8" maxlength="32" />
                </div>

                <input type="submit" value="@SharedLocalizer["Sign In"]" class="btn w-100 btn-accent" />
            </form>
            <p class="text-muted mt-4 mb-0 small">
                Moonglade @VersionHelper.AppVersion
            </p>
        </div>
    </main>
    <script type="module" src="~/js/app/base.mjs"></script>
</body>
</html>
