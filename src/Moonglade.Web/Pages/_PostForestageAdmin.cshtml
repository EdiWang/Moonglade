@using Microsoft.AspNetCore.Authorization
@using Moonglade.Auth
@inject IAuthorizationService AuthorizationService
@{
    var canManage = (await AuthorizationService.AuthorizeAsync(User, BlogAuthSchemas.AdministratorPolicy)).Succeeded;
}
@if (canManage)
{
    <div class="admin-actions">
        <div>
            <a class="btn btn-outline-accent btn-sm btn-edit" asp-page="./Admin/EditPost" asp-route-id="@Model.Post.Id"><i class="bi-pen"></i></a>
        </div>
    </div>
}
