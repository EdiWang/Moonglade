@inject Moonglade.Auth.IOwnerProfileReader OwnerProfiles
@{
    var presentation = await ViewData.CaptureOwnerPresentationAsync(OwnerProfiles, Context.RequestAborted);
}
@{
    var avatarUrl = Url.Action("Avatar", "OwnerAvatar");
    var owner = await ViewData.CaptureOwnerAsync(OwnerProfiles, Context.RequestAborted);
}

<section class="blog-info-desktop-lg text-light d-none d-lg-block h-card">
    <div class="card-background-container">
        @if (owner?.UseGravatar == true)
        {
            <gravatar class="card-bkimg" email="@owner.Email" size="256" />
        }
        else
        {
            <img class="card-bkimg" alt="" aria-hidden="true" src="@avatarUrl"/>
        }
    </div>
    <div class="blog-info-photo-text text-center">
        @if (owner?.UseGravatar == true)
        {
            <gravatar class="rounded-circle blogger-head-pic u-photo"
                      size="256"
                      alt="@presentation.Name"
                      email="@owner.Email" />
        }
        else
        {
            <img src="@avatarUrl"
                 alt="@presentation.Name"
                 class="rounded-circle blogger-head-pic u-photo"/>
        }

        <div>
            <h3 class="mt-3 text-white font-sairas heading-ownername">
                <a class="p-name u-url text-white text-decoration-none" rel="me" href="~/">@presentation.Name</a>
            </h3>

            <p class="me-3 ms-3 profile-description p-note">
                @presentation.Description
            </p>
        </div>
    </div>
</section>
