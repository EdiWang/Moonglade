@{
    var snapshot = ViewData.CaptureSettings(SettingsReader);
}
@{
    var avatarUrl = Url.Action("Avatar", "Assets");
}

<section class="blog-info-desktop-lg text-light d-none d-lg-block h-card">
    <div class="card-background-container">
        @if (snapshot.GeneralSettings.UseGravatarAsProfilePicture)
        {
            <gravatar class="card-bkimg" email="@snapshot.GeneralSettings.OwnerEmail" size="256" />
        }
        else
        {
            <img class="card-bkimg" alt="" aria-hidden="true" src="@avatarUrl"/>
        }
    </div>
    <div class="blog-info-photo-text text-center">
        @if (snapshot.GeneralSettings.UseGravatarAsProfilePicture)
        {
            <gravatar class="rounded-circle blogger-head-pic u-photo"
                      size="256"
                      alt="@snapshot.GeneralSettings.OwnerName"
                      email="@snapshot.GeneralSettings.OwnerEmail" />
        }
        else
        {
            <img src="@avatarUrl"
                 alt="@snapshot.GeneralSettings.OwnerName"
                 class="rounded-circle blogger-head-pic u-photo"/>
        }

        <div>
            <h3 class="mt-3 text-white font-sairas heading-ownername">
                <a class="p-name u-url text-white text-decoration-none" rel="me" href="~/">@snapshot.GeneralSettings.OwnerName</a>
            </h3>

            <p class="me-3 ms-3 profile-description p-note">
                @snapshot.GeneralSettings.Description
            </p>
        </div>
    </div>
</section>
