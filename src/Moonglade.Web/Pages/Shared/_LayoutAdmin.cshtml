@{
    var snapshot = ViewData.CaptureSettings(SettingsReader);
}
@inject IOptions<AuthenticationSettings> AuthOptions
@inject IConfiguration Configuration
@inject ICacheAside Cache
@inject ThemeCacheInvalidator ThemeCache

@{
    var avatarUrl = Url.Action("Avatar", "Assets");

    bool clientPreferDarkMode = Helper.IsClientPreferDarkMode(Context);
    bool hideAdminSidebar = ViewBag.HideAdminSidebar == true;
    string adminBackUrl = ViewBag.AdminBackUrl as string;

    var themeCss = await Cache.GetOrCreateAsync(BlogCachePartition.General.ToString(), ThemeCache.GetCacheKey(snapshot.AppearanceSettings.ThemeId), async () =>
    {
        return await QueryMediator.QueryAsync(new GetSiteThemeStyleSheetQuery(snapshot.AppearanceSettings.ThemeId));
    }, TimeSpan.FromMinutes(20));
}
<!DOCTYPE html>
<html lang="@snapshot.GeneralSettings.DefaultLanguageCode" data-bs-theme="@(clientPreferDarkMode ? "dark" : null)">

<head>
    <title>
        @snapshot.GeneralSettings.SiteTitle @SharedLocalizer["Admin"] @(ViewBag.Title != null ? $"- {ViewBag.Title}" : null)
    </title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @await RenderSectionAsync("meta", false)
    <link rel="start" title="@snapshot.GeneralSettings.SiteTitle" href="~/" />
    <partial name="_Favicons" />
    <link href="~/lib/twitter-bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/fonts/font.css" rel="stylesheet" />
    <link href="~/css/base.css" rel="stylesheet" />
    <link href="~/css/admin.css" rel="stylesheet" />
    @if (!string.IsNullOrEmpty(themeCss))
    {
        themeCss = themeCss.Replace("</style", string.Empty, StringComparison.OrdinalIgnoreCase);
        <style>@Html.Raw(themeCss)</style>
    }
    <link href="~/Moonglade.Web.styles.css" rel="stylesheet" />
    @await RenderSectionAsync("head", false)
</head>

<body class="admin-body bg-gray-1">
    <nav class="admin-navbar navbar navbar-expand navbar-moonglade" data-bs-theme="dark">
        <a class="navbar-brand font-sairas" asp-page="/Admin/Dashboard">
            @snapshot.GeneralSettings.SiteTitle
        </a>
        <div class="navbar-collapse">
            @if (!string.IsNullOrEmpty(adminBackUrl))
            {
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="btn-nav-back btn btn-sm btn-outline-light my-1 me-2" href="@adminBackUrl" title="Back">
                            <i class="bi-arrow-left me-1"></i>
                            @SharedLocalizer["Back"]
                        </a>
                    </li>
                </ul>
            }

            <ul class="navbar-nav @(string.IsNullOrEmpty(adminBackUrl) ? "ms-auto" : "")">
                @await RenderSectionAsync("navbarActions", false)
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Admin/About" title="about link">
                        <i class="bi-info-circle"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Index" target="_blank" title="home page link">
                        <i class="bi-house"></i>
                    </a>
                </li>
            </ul>

            <span class="navbar-text me-2">
                @if (AuthOptions.Value.Provider == AuthenticationProvider.Local)
                {
                    <a asp-page="/Admin/LocalAccount">
                        <img src="@avatarUrl" alt="@snapshot.GeneralSettings.OwnerName"
                             class="rounded-circle admin-nav-head-pic me-1" />
                        <userinfo user="User" user-info-display="PreferName"></userinfo>
                    </a>
                }
                else
                {
                    <img src="@avatarUrl" alt="@snapshot.GeneralSettings.OwnerName"
                         class="rounded-circle admin-nav-head-pic me-1" />
                    <userinfo user="User"></userinfo>
                }
            </span>

            <a class="navbar-text d-inline-block" asp-controller="Auth" asp-action="SignOut" title="Sign Out">
                <i class="bi-box-arrow-right"></i>
            </a>
        </div>
    </nav>
    @if (hideAdminSidebar)
    {
        <div class="admin-editor-wrapper" x-data="@ViewBag.XData">
            @RenderBody()
        </div>
    }
    else
    {
        <div class="d-flex admin-body-wrapper">
            <partial name="_AsideAdmin" />
            <main class="admin-main" x-data="@ViewBag.XData">
                @await RenderSectionAsync("admintoolbar", false)

                <div class="admin-main-body" tabindex="0">
                    @RenderBody()
                </div>
            </main>
        </div>
    }

    <partial name="_Toast" />
    <partial name="_AdminConfirmModal" />

    <script src="~/lib/twitter-bootstrap/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="~/js/app/base.mjs"></script>

    @await RenderSectionAsync("scripts", false)
</body>

</html>
