@model SettingsSnapshotProbe
@inject SnapshotRenderGate Gate
@{
    await Gate.PauseFirstRender();
    if (!ReferenceEquals(Model, ViewData[SnapshotProbeStore.ViewDataKey]))
    {
        throw new InvalidOperationException("The partial did not inherit the captured snapshot.");
    }
}
partial:@Model.Feed.FeedItemCount:@Model.Menu.Menus![0]!.Title
