@model SettingsSnapshotProbe
@{
    Layout = "~/Views/StructuralProbe/_SnapshotLayout.cshtml";
}
root:@Model.Feed.FeedItemCount:@Model.Menu.Menus![0]!.Title
avatar:@(string.IsNullOrEmpty(Model.AvatarUrl) ? Url.Action("Avatar", "Assets") : Model.AvatarUrl)
@await Html.PartialAsync("~/Views/StructuralProbe/_SnapshotPartial.cshtml")
@await Component.InvokeAsync("SnapshotProbe")
