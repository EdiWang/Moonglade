@page "/s0/probe/page"
@model SnapshotPageProbeModel
@{
    Layout = "~/Views/StructuralProbe/_SnapshotLayout.cshtml";
    var snapshot = Model.Snapshot;
}
root:@snapshot.Feed.FeedItemCount:@snapshot.Menu.Menus![0]!.Title
avatar:@Url.Action("Avatar", "Assets")
@await Html.PartialAsync("~/Views/StructuralProbe/_SnapshotPartial.cshtml", snapshot)
@await Component.InvokeAsync("SnapshotProbe")
